generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/clientflow"
}

datasource db {
  provider = "postgresql"
  url      = env("CLIENTFLOW_DATABASE_URL")
}

enum CfEnrollmentStatus {
  interested
  pending_review
  approved
  onboarding
  active
  on_hold
  completed
  declined
  withdrawn
}

model CfClient {
  id                 String   @id @default(cuid())
  organizationId     String
  businessName       String
  primaryContactName String
  email              String
  phone              String
  website            String?
  socialLinks        Json     @default("[]")
  programId          String?
  status             String   @default("New Intake")
  profileType        String?
  relationshipType   String?
  lifecycleStatus    String?
  assignedStaff      String
  assignedUserId     String?
  intakeSource       String   @default("admin_created")
  source             String?
  nextFollowUpDate   DateTime?
  convertedAt        DateTime?
  isDemo             Boolean  @default(false)
  isArchived         Boolean  @default(false)
  archiveReason      String?
  finalStatus        String?
  archivedAt         DateTime?
  intake             Json
  snapchat           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, isDemo])
  @@index([organizationId, isArchived])
}

model CfProgram {
  id                         String   @id @default(cuid())
  organizationId             String
  name                       String
  description                String
  isActive                   Boolean  @default(true)
  financialTrackingEnabled   Boolean  @default(false)
  defaultFormTemplateId      String
  defaultMonitoringFrequency String
  defaultContractTemplateId  String
  defaultWorkflow            Json     @default("[]")
  requiredDocuments          Json     @default("[]")
  statusPipeline             Json     @default("[]")
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([organizationId])
}

model CfFormTemplate {
  id             String   @id @default(cuid())
  organizationId String
  programId      String?
  scope          String   @default("legacy")
  version        Int      @default(1)
  sortOrder      Int      @default(0)
  name           String
  description    String
  fields         Json     @default("[]")
  emailTemplate  String   @db.Text
  internalNotes  String?
  dueInDays      Int      @default(7)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, scope, programId])
}

model CfFormAssignment {
  id               String    @id @default(cuid())
  organizationId   String
  clientId         String
  enrollmentId     String?
  formId           String
  assignedUserId   String?
  completionMethod String?
  deliveryMethod   String?
  recipientEmail   String?
  recipientPhone   String?
  status           String    @default("draft")
  dueAt            DateTime?
  sentAt           DateTime?
  openedAt         DateTime?
  startedAt        DateTime?
  submittedAt      DateTime?
  cancelledAt      DateTime?
  dueDate          String?
  secureLink       String?
  secureLinkToken  String?   @unique
  responses        Json?
  editHistory      Json?
  createdByUserId  String?
  isDemo           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([organizationId])
  @@index([organizationId, isDemo])
  @@index([organizationId, clientId])
  @@index([enrollmentId])
}

model CfTerms {
  id                    String   @id @default(cuid())
  organizationId        String
  clientId              String
  enrollmentId          String?
  programId             String
  supportType           String
  fundingAmount         Float    @default(0)
  resourceDescription   String
  grantAmount           Float    @default(0)
  loanAmount            Float    @default(0)
  investmentAmount      Float    @default(0)
  forgivableAmount      Float    @default(0)
  repaymentRequired     Boolean  @default(false)
  repaymentSchedule     String
  interestDescription   String
  milestones            String
  reportingRequirements String
  startDate             String
  endDate               String
  monitoringFrequency   String
  specialConditions     String
  approvalStatus        String   @default("Pending")
  isDemo                Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([organizationId, isDemo])
  @@index([organizationId, clientId])
  @@index([enrollmentId])
}

model CfMonitoringItem {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  enrollmentId   String?
  programId      String
  type           String
  dueDate        DateTime
  status         String    @default("Scheduled")
  assignedStaff  String
  notes          String    @default("")
  completedAt    DateTime?
  isDemo         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([organizationId, isDemo])
  @@index([organizationId, clientId])
  @@index([enrollmentId])
}

model CfContract {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  enrollmentId   String?
  programId      String
  termsId        String?
  contractType   String
  status         String    @default("Draft")
  content        String    @db.Text
  sentAt         DateTime?
  signedAt       DateTime?
  isDemo         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([organizationId, isDemo])
  @@index([organizationId, clientId])
  @@index([enrollmentId])
}

model CfDocument {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  enrollmentId   String?
  name           String
  type           String
  url            String
  uploadedAt     DateTime @default(now())
  uploadedBy     String
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, isDemo])
  @@index([organizationId, clientId])
  @@index([enrollmentId])
}

model CfCommunication {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  enrollmentId   String?
  type           String
  direction      String
  subject        String
  notes          String   @default("")
  date           DateTime
  staffMember    String
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, isDemo])
  @@index([organizationId, clientId])
  @@index([enrollmentId])
}

model CfFinalReport {
  id                   String   @id @default(cuid())
  organizationId       String
  clientId             String
  enrollmentId         String?
  programId            String
  startDate            String
  endDate              String
  originalNeed         String
  supportProvided      String
  fundingProvided      String
  milestonesCompleted  String
  resultsAchieved      String
  issuesEncountered    String
  staffComments        String
  clientOutcome        String
  recommendedNextSteps String
  archiveDecision      String
  isDemo               Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([organizationId, isDemo])
  @@index([organizationId, clientId])
  @@index([enrollmentId])
}

model CfActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  enrollmentId   String?
  action         String
  description    String
  user           String
  timestamp      DateTime @default(now())
  isDemo         Boolean  @default(false)

  @@index([organizationId])
  @@index([organizationId, isDemo])
  @@index([organizationId, clientId])
  @@index([enrollmentId])
}

model CfProgramEnrollment {
  id                 String             @id @default(cuid())
  organizationId     String
  clientId           String
  programId          String
  status             CfEnrollmentStatus @default(interested)
  assignedUserId     String?
  assignedStaff      String?
  startDate          DateTime?
  nextAction         String?
  nextActionDate     DateTime?
  progressPercentage Int                @default(0)
  completedAt        DateTime?
  withdrawnAt        DateTime?
  onHoldReason       String?
  isDemo             Boolean            @default(false)
  isArchived         Boolean            @default(false)
  archivedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@unique([clientId, programId])
  @@index([organizationId])
  @@index([organizationId, programId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, isDemo])
}

model CfEnrollmentStatusHistory {
  id              String             @id @default(cuid())
  organizationId  String
  enrollmentId    String
  previousStatus  CfEnrollmentStatus?
  newStatus       CfEnrollmentStatus
  changedByUserId String?
  reason          String?
  createdAt       DateTime           @default(now())

  @@index([organizationId, enrollmentId])
  @@index([enrollmentId, createdAt])
}

model CfIntakeSubmission {
  id                 String   @id @default(cuid())
  organizationId     String
  clientId           String
  formAssignmentId   String   @unique
  idempotencyKey     String
  requestHash        String
  configurationToken String
  responsePayload    Json
  resultPayload      Json
  source             String
  submitterEmail     String?
  submitterName      String?
  submittedAt        DateTime @default(now())
  isDemo             Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, clientId])
  @@index([organizationId, isDemo])
}

model CfIntakeRenderSession {
  id                  String   @id @default(cuid())
  organizationId      String
  formAssignmentId    String
  configurationToken  String   @unique
  coreTemplateId      String
  coreTemplateVersion Int
  renderedSections    Json
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  @@index([organizationId, formAssignmentId])
  @@index([expiresAt])
}

model CfIntakeSubmissionSnapshot {
  id                  String   @id @default(cuid())
  organizationId      String
  intakeSubmissionId  String   @unique
  coreTemplateId      String
  coreTemplateVersion Int
  selectedProgramIds  String[]
  renderedSections    Json
  createdAt           DateTime @default(now())

  @@index([organizationId])
}

model CfIntakeSubmissionProgram {
  id                 String   @id @default(cuid())
  organizationId     String
  intakeSubmissionId String
  programId          String
  enrollmentId       String
  createdAt          DateTime @default(now())

  @@unique([intakeSubmissionId, programId])
  @@index([organizationId, programId])
  @@index([enrollmentId])
}

model CfTask {
  id             String    @id @default(cuid())
  organizationId String
  enrollmentId   String
  clientId       String
  title          String
  description    String?
  status         String    @default("open")
  priority       String    @default("medium")
  assignedUserId String?
  assignedStaff  String?
  dueDate        DateTime?
  completedAt    DateTime?
  isDemo         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, enrollmentId])
  @@index([organizationId, clientId])
  @@index([organizationId, isDemo])
  @@index([dueDate])
}
